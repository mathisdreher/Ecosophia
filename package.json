{
  "name": "ecosophia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ecosophia: roots, branches and mycelium of political ecology. A bilingual static site built with Astro and deployed to GitHub Pages.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "validate": "node scripts/validate-data.mjs",
    "predev": "npm run tokens",
    "dev": "astro dev",
    "prebuild": "npm run tokens && npm run validate",
    "build": "astro build",
    "preview": "astro preview",
    "wikidata": "node scripts/wikidata-check.mjs",
    "portraits": "node scripts/portraits.mjs",
    "clearing": "node clearing/run.mjs",
    "test:clearing": "node --test clearing/test/pipeline.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astro": "^7.4.11",
    "d3-force": "^3.0.1",
    "d3-geo": "^3.1.2",
    "sharp": "^0.35.5",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "yaml": "^2.9.1"
  }
}
