---
// The only page route: every view of the site, in both languages, is
// generated from the route table in src/i18n/routes.mjs.
import { loadCorpus } from '../../lib/corpus.mjs';
import { allRoutes } from '../../i18n/routes.mjs';
import Home from '../../views/Home.astro';
import Author from '../../views/Author.astro';
import Authors from '../../views/Authors.astro';
import Branch from '../../views/Branch.astro';
import Branches from '../../views/Branches.astro';
import Roots from '../../views/Roots.astro';
import Trunk from '../../views/Trunk.astro';
import Seeds from '../../views/Seeds.astro';
import Mycelium from '../../views/Mycelium.astro';
import Rings from '../../views/Rings.astro';
import Canopy from '../../views/Canopy.astro';
import Terrain from '../../views/Terrain.astro';
import Clearing from '../../views/Clearing.astro';
import Method from '../../views/Method.astro';
import Data from '../../views/Data.astro';

export function getStaticPaths() {
  return allRoutes(loadCorpus()).map((r) => ({
    params: { lang: r.lang, path: r.slug || undefined },
    props: { view: r.view, id: r.id },
  }));
}

const { lang } = Astro.params;
const { view, id } = Astro.props;
const VIEWS = {
  home: Home,
  author: Author,
  authors: Authors,
  branch: Branch,
  branches: Branches,
  roots: Roots,
  trunk: Trunk,
  seeds: Seeds,
  mycelium: Mycelium,
  rings: Rings,
  canopy: Canopy,
  terrain: Terrain,
  clearing: Clearing,
  method: Method,
  data: Data,
};
const View = VIEWS[view];
---

<View lang={lang} view={view} id={id} />
