---
// Header search over authors, seeds, works and branches. The index is a small
// JSON file built with the site; nothing is sent to a server.
import { useUi } from '../i18n/ui.mjs';
import { href, withBase } from '../lib/site.mjs';

const { lang } = Astro.props;
const { t } = useUi(lang);
const kinds = JSON.stringify({
  author: t('search.author'),
  seed: t('search.seed'),
  work: t('search.work'),
  branch: t('search.branch'),
});
---

<form
  class="search"
  role="search"
  action={href(lang, 'authors')}
  data-search
  data-index={withBase(`/search-${lang}.json`)}
  data-kinds={kinds}
  data-none={t('search.none')}
>
  <button type="button" class="icon-btn search-toggle" aria-expanded="false" aria-label={t('search.label')} data-search-toggle>
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="M15.5 15.5 21 21"></path></svg>
  </button>
  <div class="search-field">
    <label class="visually-hidden" for="q">{t('search.label')}</label>
    <input id="q" name="q" type="search" autocomplete="off" spellcheck="false" placeholder={t('search.placeholder')} />
  </div>
  <ul class="search-results" data-results hidden aria-label={t('search.results')}></ul>
  <span class="visually-hidden" aria-live="polite" data-status></span>
</form>

<script>
  const root = document.querySelector<HTMLFormElement>('[data-search]');
  if (root) {
    const input = root.querySelector<HTMLInputElement>('input')!;
    const list = root.querySelector<HTMLUListElement>('[data-results]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-search-toggle]')!;
    const kinds = JSON.parse(root.dataset.kinds || '{}');
    type Entry = { k: string; l: string; s: string; u: string; f: string };
    let index: Entry[] | null = null;
    let current = -1;

    const fold = (s: string) =>
      s
        .normalize('NFD')
        .replace(/[̀-ͯ]/g, '')
        .replace(/æ/gi, 'ae')
        .replace(/ø/gi, 'o')
        .replace(/œ/gi, 'oe')
        .toLowerCase();

    async function load() {
      if (!index) {
        try {
          const res = await fetch(root!.dataset.index!);
          index = await res.json();
        } catch {
          index = [];
        }
      }
      return index!;
    }

    function close() {
      list.hidden = true;
      list.replaceChildren();
      current = -1;
    }

    function score(e: Entry, q: string) {
      const label = fold(e.l);
      if (label.startsWith(q)) return 0;
      if (label.split(/[\s'’-]+/).some((w) => w.startsWith(q))) return 1;
      if (label.includes(q)) return 2;
      return e.f.includes(q) ? 3 : -1;
    }

    async function run() {
      const q = fold(input.value.trim());
      if (q.length < 2) return close();
      const entries = await load();
      const order: Record<string, number> = { author: 0, branch: 1, seed: 2, work: 3 };
      const hits = entries
        .map((e) => ({ e, s: score(e, q) }))
        .filter((h) => h.s >= 0)
        .sort((a, b) => a.s - b.s || order[a.e.k] - order[b.e.k] || a.e.l.localeCompare(b.e.l))
        .slice(0, 12);
      list.replaceChildren();
      current = -1;
      if (hits.length === 0) {
        const li = document.createElement('li');
        li.className = 'empty';
        li.textContent = `${root!.dataset.none} “${input.value.trim()}”`;
        list.append(li);
      }
      for (const { e } of hits) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = e.u;
        const kind = document.createElement('span');
        kind.className = 'kind';
        kind.textContent = kinds[e.k] ?? e.k;
        const body = document.createElement('span');
        const what = document.createElement('span');
        what.className = 'what';
        what.textContent = e.l;
        body.append(what);
        if (e.s) {
          const sub = document.createElement('span');
          sub.className = 'sub';
          sub.textContent = e.s;
          body.append(sub);
        }
        a.append(kind, body);
        li.append(a);
        list.append(li);
      }
      list.hidden = false;
      status.textContent = String(hits.length);
    }

    function move(delta: number) {
      const links = [...list.querySelectorAll('a')];
      if (links.length === 0) return;
      current = (current + delta + links.length) % links.length;
      links.forEach((a, i) => a.classList.toggle('is-current', i === current));
      links[current].scrollIntoView({ block: 'nearest' });
    }

    input.addEventListener('focus', load, { once: true });
    input.addEventListener('input', run);
    input.addEventListener('keydown', (ev) => {
      if (ev.key === 'ArrowDown') {
        ev.preventDefault();
        move(1);
      } else if (ev.key === 'ArrowUp') {
        ev.preventDefault();
        move(-1);
      } else if (ev.key === 'Escape') {
        close();
      }
    });
    root.addEventListener('submit', (ev) => {
      const links = [...list.querySelectorAll('a')];
      const target = links[current] ?? links[0];
      if (target) {
        ev.preventDefault();
        window.location.href = target.href;
      }
    });
    document.addEventListener('click', (ev) => {
      if (!root.contains(ev.target as Node)) close();
    });
    toggle.addEventListener('click', () => {
      const open = root.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(open));
      if (open) input.focus();
      else close();
    });
  }
</script>
