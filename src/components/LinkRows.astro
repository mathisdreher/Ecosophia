---
// A list of mycelium links as rows: who, which thread, whom, what passed, source.
import Thread from './Thread.astro';
import { useUi } from '../i18n/ui.mjs';
import { href } from '../lib/site.mjs';
import { L, citeHtml } from '../lib/text.mjs';
import { loadCorpus } from '../lib/corpus.mjs';

const { links, lang } = Astro.props;
const { t } = useUi(lang);
const c = loadCorpus();
const rel = { influenced: t('relation.typeInfluenced'), critiqued: t('relation.typeCritiqued'), dialogue: t('relation.typeDialogue') };
---

<ul class="link-rows">
  {
    links.map((l) => (
      <li>
        <span class="who">
          <a class="strong-link" href={href(lang, 'author', l.from)}>{c.authorById[l.from].name}</a>
          <span class="rel label">
            <Thread type={l.type} width={24} />
            {rel[l.type]}
          </span>
          <a class="strong-link" href={href(lang, 'author', l.to)}>{c.authorById[l.to].name}</a>
        </span>
        <span class="text">{L(l.note, lang)}</span>
        <span class="eco-meta" set:html={citeHtml(c.sources.get(l.source), lang)} />
      </li>
    ))
  }
</ul>

<style>
  .link-rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4) 0;
    border-top: 1px solid var(--line);
  }
  .who {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
  }
  .text {
    font-size: 15px;
    line-height: 23px;
  }
</style>
