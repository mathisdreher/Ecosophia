---
// AuthorLeaf: the author card. Leaf cut on two corners, a branch line on top,
// up to three seeds, the primary chip and any secondary chips, and the
// generated pencil portrait (or the leaf placeholder).
import AuthorChips from './AuthorChips.astro';
import { L } from '../lib/text.mjs';
import { href } from '../lib/site.mjs';
import { withBase } from '../lib/site.mjs';
import { lifespan, placeLabel, loadCorpus, portraitOf } from '../lib/corpus.mjs';

const { author, lang, heading = 'h3' } = Astro.props;
const c = loadCorpus();
const H = heading;
const face = portraitOf(author);
const meta = [lifespan(author, lang), placeLabel(author, lang)].filter(Boolean).join(' · ');
---

<article class="eco-leaf" style={`--chip: var(--${author.token})`}>
  <div class="leaf-head">
    {face.src && <img class="face" src={withBase(face.src)} alt="" width="76" height="76" loading="lazy" />}
    <div>
      <H class="leaf-name"><a href={href(lang, 'author', author.id)}>{author.name}</a></H>
      {meta && <div class="eco-meta">{meta}</div>}
    </div>
  </div>
  {
    author.seeds.length > 0 && (
      <ul>
        {author.seeds.map((s) => (
          <li>
            <b>{L(c.seeds[s.seed].name, lang)}.</b> {L(s.text, lang)}
          </li>
        ))}
      </ul>
    )
  }
  <div class="eco-chips"><AuthorChips author={author} lang={lang} link={false} /></div>
</article>

<style>
  .leaf-head {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .face {
    width: 76px;
    height: 76px;
    flex: none;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: 0 20px 0 20px;
    border: 2px solid var(--chip);
    background: var(--paper);
  }
  .leaf-name {
    font: 600 24px/30px var(--font-display);
    letter-spacing: -0.01em;
    margin: 0;
  }
  .leaf-name a:hover {
    color: var(--chip, var(--moss));
  }
  ul:empty {
    display: none;
  }
  .eco-leaf > .eco-chips {
    padding-top: var(--space-4);
  }
</style>
