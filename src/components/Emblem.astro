---
// A branch emblem, drawn with Gemini in bark and moss (public/glyphs/branches;
// the small set, bolder, below 40 px). Decorative: the branch name is always
// next to it.
import fs from 'node:fs';
import path from 'node:path';

const { branch, size = 32 } = Astro.props;
const dir = path.join(process.cwd(), 'public/glyphs/branches');
const small = path.join(dir, 'small', `${branch}.svg`);
const file = size < 40 && fs.existsSync(small) ? small : path.join(dir, `${branch}.svg`);
const svg = fs.existsSync(file)
  ? fs
      .readFileSync(file, 'utf8')
      .replaceAll('fill="#2a2219"', 'fill="currentColor"')
      .replaceAll('stroke="#2a2219"', 'stroke="currentColor"')
      .replaceAll('fill="#3d5a2a"', 'style="fill:var(--moss)"')
      .replace(/<title>.*?<\/title>/, '')
      .replace(/width="[\d.]+" height="[\d.]+"/, '')
      .replace('<svg ', `<svg aria-hidden="true" focusable="false" class="emblem" style="width:${size}px;height:${size}px;color:var(--ink);flex:none" `)
  : '';
---

<Fragment set:html={svg} />
