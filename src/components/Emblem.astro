---
// A branch emblem (public/glyphs/branches), inlined in the branch colour.
// Decorative: the branch name is always next to it.
import fs from 'node:fs';
import path from 'node:path';

const { branch, size = 32 } = Astro.props;
const file = path.join(process.cwd(), 'public/glyphs/branches', `${branch}.svg`);
const svg = fs.existsSync(file)
  ? fs
      .readFileSync(file, 'utf8')
      .replaceAll('#2a2219', 'currentColor')
      .replace(/<title>.*?<\/title>/, '')
      .replace('<svg ', `<svg aria-hidden="true" focusable="false" class="emblem" style="width:${size}px;height:${size}px;color:var(--chip, var(--ink));flex:none" `)
  : '';
---

<Fragment set:html={svg} />
