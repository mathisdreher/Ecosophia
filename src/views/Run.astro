---
// One Clearing run. Above the ground line: the claim, where the schools
// stand, who stood with whom, and the closing line of every agent. Below it,
// the evidence: how the run was made, what each agent was told, and
// everything the agents wrote. Nothing here is set as a quotation.
import Base from '../layouts/Base.astro';
import RunBoard from '../components/RunBoard.astro';
import VoiceCard from '../components/VoiceCard.astro';
import ClaimSource from '../components/ClaimSource.astro';
import QuestionPositions from '../components/QuestionPositions.astro';
import { useUi } from '../i18n/ui.mjs';
import { href, withBase } from '../lib/site.mjs';
import { L, typo } from '../lib/text.mjs';
import { loadCorpus, loadClearing, loadTranscript, runMeasures } from '../lib/corpus.mjs';
import { runDate } from '../lib/clearing.mjs';

const { lang, id } = Astro.props;
const { t } = useUi(lang);
const c = loadCorpus();
const run = loadClearing().runs.find((r) => r.id === id);
const record = loadTranscript(run.id);
const draft = run.status !== 'published';
const nf = new Intl.NumberFormat(lang === 'fr' ? 'fr-FR' : 'en-GB');
const meta = t('clearing.runMeta', { agents: run.settings.agents, rounds: run.settings.rounds, comments: run.counts.comments, date: runDate(run, lang) });
const engineText = t('clearing.engine', {
  engine: run.engine.name,
  commit: String(run.engine.commit).slice(0, 7),
  model: run.model.served?.length ? run.model.served.join(', ') : run.model.requested,
  effort: run.model.effort ? t('clearing.effort', { effort: run.model.effort }) : '',
  turns: nf.format(run.counts.turns),
  tokensIn: nf.format(run.counts.tokensIn),
  tokensOut: nf.format(run.counts.tokensOut),
  declined: run.counts.declined,
  failed: run.counts.failed,
});
const name = (authorId) => c.authorById[authorId]?.short ?? authorId;
const transcript = record?.transcript ?? [];
const rounds = [...new Set(transcript.map((e) => e.round))].sort((a, b) => a - b);
const lines = (round) => transcript.filter((e) => e.round === round && ['post', 'comment', 'like', 'dislike'].includes(e.type));
const prompts = record?.prompts ?? null;
const T = (en, fr) => typo(lang === 'fr' ? fr : en, lang);
// The debate as the agents saw it on the simulated forum: every comment with
// the agents who approved or disapproved it.
const comments = transcript.filter((e) => e.type === 'comment' && e.author).map((e) => ({ ...e, likes: [], dislikes: [] }));
const byText = new Map(comments.map((cm) => [cm.text.trim(), cm]));
for (const e of transcript) {
  if (e.type !== 'like' && e.type !== 'dislike') continue;
  const cm = byText.get((e.about ?? '').trim());
  if (cm && e.author) (e.type === 'like' ? cm.likes : cm.dislikes).push(e.author);
}
const feedRounds = [...new Set(comments.map((cm) => cm.round))].sort((a, b) => a - b);
const mostLiked = [...comments].filter((cm) => cm.likes.length > 0).sort((a, b) => b.likes.length - a.likes.length || a.dislikes.length - b.dislikes.length).slice(0, 3);
const mostContested = [...comments].filter((cm) => cm.dislikes.length > 0).sort((a, b) => b.dislikes.length - a.dislikes.length || b.likes.length - a.likes.length).slice(0, 3);
const tokenOf = (id) => c.authorById[id]?.token ?? 'ink';
const names = (ids) => ids.map(name).join(', ');
const agentPrompts = Object.entries(prompts?.agents ?? {}).filter(([, text]) => text);
---

<Base lang={lang} view="run" id={id} title={`${t('clearing.runTitle', { id: run.runId })}: ${L(run.claim, lang)}`} description={L(run.summary, lang)} noindex={draft}>
  <section class="head">
    <nav class="crumbs" aria-label={lang === 'fr' ? 'Fil d’Ariane' : 'Breadcrumb'}>
      <a href={href(lang, 'clearing')}>{t('clearing.title')}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{run.runId}</span>
    </nav>
    <span class="eco-mark simulated">{t('common.simulated')}</span>
    <h1 class="t-title claim-line">{L(run.claim, lang)}</h1>
    <p class="t-lede summary">{L(run.summary, lang)}</p>
    <span class="eco-meta">
      {run.runId} · {meta}
    </span>
    {run.claimSource && <ClaimSource source={run.claimSource} lang={lang} />}
    {run.question && <QuestionPositions measures={runMeasures(run)} lang={lang} open />}
    {
      draft && (
        <div class="notice lichen">
          <b class="label">{t('clearing.draftTitle')}</b>
          <p class="t-small">{t('clearing.draft')}</p>
        </div>
      )
    }
  </section>

  <section class="wrap run-wrap">
    <RunBoard run={run} lang={lang} mark="simulated" />
  </section>

  <section class="voices wrap">
    <h2 class="t-heading">{t('clearing.voicesAll')}</h2>
    <div class="voice-grid">
      {run.voices.map((v) => <VoiceCard voice={v} run={run} lang={lang} />)}
    </div>
    {
      run.silent?.length > 0 && (
        <p class="t-small t-muted">
          {t('clearing.silent')} {run.silent.map((s) => t('clearing.agentPrompt', { name: name(s) })).join(', ')}.
        </p>
      )
    }
  </section>

  {
    comments.length > 0 && (
      <section class="feed wrap">
        <div class="feed-head">
          <span class="eco-mark simulated">{t('common.simulated')}</span>
          <h2 class="t-heading">{T('The thread of the debate', 'Le fil du débat')}</h2>
          <p class="t-small t-muted">{T('The forum the agents debated on, as the OASIS engine recorded it: each comment, round by round, with the agents who approved (▲) or disapproved (▼) of it. Written by agents, never by the authors named.', 'Le forum sur lequel les agents ont débattu, tel que le moteur OASIS l’a enregistré : chaque commentaire, tour par tour, avec les agents qui l’ont approuvé (▲) ou désapprouvé (▼). Écrit par des agents, jamais par les auteurs nommés.')}</p>
        </div>
        <div class="highlights">
          {[[T('Most approved', 'Les plus approuvés'), mostLiked], [T('Most contested', 'Les plus contestés'), mostContested]].map(([title, list]) =>
            list.length > 0 && (
              <div>
                <h3 class="label">{title}</h3>
                <ol class="cards">
                  {list.map((cm) => (
                    <li class="cm" style={`--chip: var(--${tokenOf(cm.author)})`}>
                      <span class="who"><span class="dot" />{t('clearing.agentPrompt', { name: name(cm.author) })}</span>
                      <p lang="en">{cm.text}</p>
                      <span class="react eco-meta">
                        <span title={names(cm.likes)}>▲ {cm.likes.length}</span> <span title={names(cm.dislikes)}>▼ {cm.dislikes.length}</span>
                      </span>
                    </li>
                  ))}
                </ol>
              </div>
            ),
          )}
        </div>
        {feedRounds.map((r) => (
          <details class="round" open={r === feedRounds[0]}>
            <summary class="t-heading">{t('clearing.round', { n: r })} <span class="eco-meta">· {comments.filter((cm) => cm.round === r).length} {T('comments', 'commentaires')}</span></summary>
            <ol class="thread">
              {comments.filter((cm) => cm.round === r).map((cm) => (
                <li class="cm" style={`--chip: var(--${tokenOf(cm.author)})`}>
                  <span class="who"><span class="dot" />{t('clearing.agentPrompt', { name: name(cm.author) })}</span>
                  <p lang="en">{cm.text}</p>
                  {(cm.likes.length > 0 || cm.dislikes.length > 0) && (
                    <span class="react eco-meta">
                      {cm.likes.length > 0 && <span>▲ {cm.likes.length} · {names(cm.likes)}</span>}
                      {cm.dislikes.length > 0 && <span>▼ {cm.dislikes.length} · {names(cm.dislikes)}</span>}
                    </span>
                  )}
                </li>
              ))}
            </ol>
          </details>
        ))}
      </section>
    )
  }

  <div class="below-grid evidence" slot="below">
    <div class="below-col">
      <div class="below-head">
        <span class="label humus">{t('clearing.engineLabel')}</span>
        <h2 class="t-heading">{t('clearing.engineTitle')}</h2>
      </div>
      <p class="text">{engineText}</p>
      <p class="text">{t('clearing.limits')}</p>
      <div class="row gap-6 t-small">
        <a class="link" href={href(lang, 'method', undefined, 'simulated')}>{t('clearing.readMethod')}</a>
        {record && <a class="link" href={withBase(`/clearing/${run.id}.json`)}>{t('clearing.download')}</a>}
      </div>
    </div>

    {
      run.plan && (
        <div class="below-col">
          <div class="below-head">
            <span class="label humus">{t('clearing.engineLabel')}</span>
            <h2 class="t-heading">{t('clearing.planTitle')}</h2>
          </div>
          <p class="text">
            {t('clearing.plan', { model: run.plan.model, budget: run.settings.budgetUsd ? `${run.settings.budgetUsd} USD` : t('clearing.noBudget') })} {run.plan.note}
          </p>
          <ul class="reasons t-small">
            {Object.entries(run.plan.reasons).map(([id, why]) => (
              <li>
                <b>{name(id)}</b> {why}
              </li>
            ))}
          </ul>
        </div>
      )
    }
    {
      prompts && (
        <div class="below-col">
          <div class="below-head">
            <span class="label humus">{t('clearing.promptsLabel')}</span>
            <h2 class="t-heading">{t('clearing.promptsTitle')}</h2>
          </div>
          <p class="text">{t('clearing.prompts')}</p>
          <details>
            <summary>{t('clearing.opening')}</summary>
            <pre lang="en">{prompts.opening}</pre>
          </details>
          <details>
            <summary>{t('clearing.interview')}</summary>
            <pre lang="en">{prompts.interview}</pre>
          </details>
          <details>
            <summary>
              {t('clearing.agentPrompts')} <span class="eco-meta">({agentPrompts.length})</span>
            </summary>
            <div class="nested">
              {agentPrompts.map(([authorId, text]) => (
                <details>
                  <summary>{t('clearing.agentPrompt', { name: name(authorId) })}</summary>
                  <pre lang="en">{text}</pre>
                </details>
              ))}
            </div>
          </details>
        </div>
      )
    }

    {
      transcript.length > 0 && (
        <div class="below-col wide">
          <div class="below-head">
            <span class="label humus">{t('clearing.transcriptLabel')}</span>
            <h2 class="t-heading">{t('clearing.transcriptTitle')}</h2>
          </div>
          <p class="text">{t('clearing.transcript')}</p>
          {rounds.map((r) => (
            <details>
              <summary>
                {r === 0 ? t('clearing.opening') : t('clearing.round', { n: r })} <span class="eco-meta">({lines(r).length})</span>
              </summary>
              <ol class="lines">
                {lines(r).map((e) => (
                  <li>
                    <b>{e.author ? t('clearing.agentPrompt', { name: name(e.author) }) : t('clearing.moderator')}</b>
                    {e.type === 'post' || e.type === 'comment' ? (
                      <span lang="en">{e.text}</span>
                    ) : (
                      <span class="t-muted">{t(e.type === 'like' ? 'clearing.liked' : 'clearing.disliked', { name: e.to ? name(e.to) : '?' })}</span>
                    )}
                  </li>
                ))}
              </ol>
            </details>
          ))}
        </div>
      )
    }
  </div>
</Base>

<style>
  .feed {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-bottom: 72px;
  }
  .feed-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    max-width: 72ch;
  }
  .highlights {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr));
    gap: var(--space-6);
  }
  .cards,
  .thread {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .cm {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    border: var(--stroke-thread) dashed var(--lichen-ink);
    border-left: 3px solid var(--chip);
    border-radius: var(--radius-md);
    background: var(--paper-raised);
  }
  .cm p {
    margin: 0;
    font: 400 15px/22px var(--font-sans);
  }
  .who {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font: 600 13px/18px var(--font-sans);
  }
  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--chip);
  }
  .react {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
  }
  .round summary {
    cursor: pointer;
    padding: var(--space-2) 0;
    border-top: 1px solid var(--line);
  }
  .thread {
    max-width: 860px;
  }
  .head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    max-width: 900px;
    padding: var(--space-16) var(--gutter) var(--space-4);
  }
  .claim-line {
    text-wrap: balance;
  }
  .summary {
    max-width: var(--measure);
  }
  .run-wrap {
    padding-block: var(--space-8) 56px;
  }
  .voices {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-bottom: 72px;
  }
  .voice-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
    gap: 20px;
  }
  .evidence .text {
    font-size: 15px;
    line-height: 23px;
  }
  .evidence .wide {
    grid-column: 1 / -1;
    max-width: 900px;
  }
  .reasons {
    margin: 0;
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  details {
    border-top: 1px solid var(--line);
    padding: var(--space-2) 0;
  }
  .nested {
    padding-left: var(--space-4);
  }
  .nested summary {
    font-weight: 400;
  }
  summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 15px;
    line-height: 28px;
  }
  pre {
    margin: var(--space-2) 0 var(--space-3);
    padding: var(--space-4);
    max-height: 420px;
    overflow: auto;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font: 400 13px/20px var(--font-mono);
  }
  .lines {
    list-style: none;
    margin: var(--space-2) 0 var(--space-3);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .lines li {
    display: grid;
    grid-template-columns: minmax(0, 170px) minmax(0, 1fr);
    gap: var(--space-4);
    font-size: 15px;
    line-height: 23px;
  }
  .lines b {
    font-size: 14px;
  }
  @media (max-width: 720px) {
    .head {
      padding-top: var(--space-12);
    }
    .lines li {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }
  }
</style>
