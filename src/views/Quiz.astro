---
// The quiz: rounds of ten questions of four kinds, all drawn from the sourced
// corpus: who developed an idea (or which idea an author developed), who wrote
// a work, which school an author belongs to, and which critique an author
// made. Every answer comes with its explanation and a link to the leaf.
// Nothing here is simulated; the questions are built in the browser.
import Base from '../layouts/Base.astro';
import { href } from '../lib/site.mjs';
import { L, typo } from '../lib/text.mjs';
import { loadCorpus } from '../lib/corpus.mjs';

const { lang } = Astro.props;
const T = (en, fr) => typo(lang === 'fr' ? fr : en, lang);
const c = loadCorpus();
const groupName = (a) => (a.layer === 'leaf' ? L(c.branchById[a.branch].name, lang) : a.layer === 'root' ? (lang === 'fr' ? 'Précurseurs' : 'Precursors') : (lang === 'fr' ? 'Tronc' : 'Trunk'));
const data = {
  lang,
  authors: c.authors.map((a) => ({
    id: a.id,
    name: a.name,
    group: a.layer === 'leaf' ? a.branch : a.layer,
    groupName: groupName(a),
    token: a.token,
    url: href(lang, 'author', a.id),
    seeds: a.seeds.map((s) => ({ name: L(c.seeds[s.seed].name, lang), text: L(s.text, lang) })),
    works: a.works.filter((w) => w.title).map((w) => ({ title: w.title, year: w.year })),
    short: a.short,
  })),
  groups: [
    { id: 'root', name: lang === 'fr' ? 'Précurseurs' : 'Precursors' },
    { id: 'trunk', name: lang === 'fr' ? 'Tronc' : 'Trunk' },
    ...c.branches.map((b) => ({ id: b.id, name: L(b.name, lang) })),
  ],
  critiques: c.sourcedLinks.filter((l) => l.type === 'critiqued').map((l) => ({ target: l.from, critic: l.to, note: L(l.note, lang) })),
};
---

<Base lang={lang} view="quiz" title={T('Quiz', 'Quiz')} description={T('Ten questions to learn the ideas, books, schools and critiques of political ecology.', 'Dix questions pour apprendre les idées, les livres, les écoles et les critiques de l’écologie politique.')}>
  <section class="page-head">
    <h1 class="t-title">{T('Quiz', 'Quiz')}</h1>
    <p class="t-lede">{T('Ten questions of four kinds, drawn from the map: who developed an idea, who wrote a book, which school a thinker belongs to, which critique they made. Each answer explains itself and opens the leaf.', 'Dix questions de quatre sortes, tirées de la carte : qui a développé une idée, qui a écrit un livre, à quelle école appartient un penseur, quelle critique il a formulée. Chaque réponse s’explique et ouvre la fiche.')}</p>
  </section>

  <section class="page-body" data-quiz>
    <script type="application/json" data-quiz-data set:html={JSON.stringify(data)} />
    <div class="start" data-start>
      <ul class="kinds t-small">
        <li><b>{T('Ideas', 'Idées')}</b> {T('who developed it, or which one an author developed', 'qui l’a développée, ou laquelle un auteur a développée')}</li>
        <li><b>{T('Books', 'Livres')}</b> {T('who wrote it', 'qui l’a écrit')}</li>
        <li><b>{T('Schools', 'Écoles')}</b> {T('where a thinker belongs on the tree', 'où se trouve un penseur sur l’arbre')}</li>
        <li><b>{T('Critiques', 'Critiques')}</b> {T('which critique a thinker made', 'quelle critique un penseur a formulée')}</li>
      </ul>
      <button type="button" class="eco-btn" data-mode="all">{T('Start', 'Commencer')}</button>
    </div>

    <div class="game" data-game hidden>
      <div class="progress"><span data-bar></span></div>
      <div class="meta eco-meta"><span data-step></span><span data-score></span></div>
      <article class="q">
        <span class="label t-muted" data-kind></span>
        <h2 class="t-heading q-text" data-question></h2>
        <div class="options" data-options></div>
        <div class="feedback" data-feedback hidden>
          <p data-verdict class="verdict"></p>
          <p data-explain class="t-small"></p>
          <div class="row">
            <a class="link t-small" data-learn target="_blank" rel="noopener">{T('Open the leaf', 'Ouvrir la fiche')}</a>
            <button type="button" class="eco-btn" data-next>{T('Next', 'Suivante')}</button>
          </div>
        </div>
      </article>
    </div>

    <div class="end" data-end hidden>
      <h2 class="t-title" data-final></h2>
      <p class="t-lede" data-final-text></p>
      <ul class="met" data-met></ul>
      <button type="button" class="eco-btn" data-again>{T('Play again', 'Rejouer')}</button>
    </div>
  </section>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-quiz]');
  if (root) {
    const D = JSON.parse(root.querySelector('[data-quiz-data]')!.textContent!);
    const fr = D.lang === 'fr';
    const C = fr ? '\u00a0: ' : ': ';
    const $ = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const byId = new Map(D.authors.map((a: any) => [a.id, a]));
    const groupName = new Map(D.groups.map((g: any) => [g.id, g.name]));
    const pick = <T,>(xs: T[]) => xs[Math.floor(Math.random() * xs.length)];
    const shuffle = <T,>(xs: T[]) => xs.map((x) => [Math.random(), x] as const).sort((a, b) => a[0] - b[0]).map(([, x]) => x);
    const others = (a: any, n: number, same = false) =>
      shuffle(D.authors.filter((b: any) => b.id !== a.id && (!same || b.group === a.group))).slice(0, n);
    const distract = (a: any, n = 3) => {
      const near = others(a, 2, true);
      return [...near, ...others(a, 10).filter((b: any) => !near.includes(b))].slice(0, n);
    };

    type Q = { kind: string; text: string; options: string[]; answer: string; explain: string; learn: string; seen: string[] };
    const authorWord = fr ? 'l’auteur' : 'the author';
    const mask = (note: string, a: any) => {
      let out = note;
      for (const n of [a.name, a.short]) out = out.split(n).join(authorWord);
      return out.charAt(0).toUpperCase() + out.slice(1);
    };
    const makers: Record<string, () => Q | null> = {
      idea() {
        const withSeeds = D.authors.filter((x: any) => x.seeds.length);
        const a = pick(withSeeds);
        const s = pick(a.seeds);
        if (Math.random() < 0.5) {
          const opts = shuffle([a, ...distract(a)]);
          return { kind: fr ? 'Une idée' : 'An idea', text: `${s.name}${C}${s.text} ${fr ? 'Qui a développé cette idée ?' : 'Who developed this idea?'}`, options: opts.map((o: any) => o.name), answer: a.name, explain: `${s.name}${C}${a.name} (${a.groupName}).`, learn: a.url, seen: [a.id] };
        }
        const pool = shuffle(withSeeds.filter((x: any) => x.id !== a.id).flatMap((x: any) => x.seeds.map((y: any) => y.name)));
        const wrong = [...new Set(pool.filter((n: string) => !a.seeds.some((y: any) => y.name === n)))].slice(0, 3);
        return { kind: fr ? 'Une idée' : 'An idea', text: fr ? `Quelle idée doit-on à ${a.name} ?` : `Which idea do we owe to ${a.name}?`, options: shuffle([s.name, ...wrong]), answer: s.name, explain: `${s.name}${C}${s.text}`, learn: a.url, seen: [a.id] };
      },
      work() {
        const a = pick(D.authors.filter((x: any) => x.works.length));
        const w = pick(a.works);
        const opts = shuffle([a, ...distract(a)]);
        return { kind: fr ? 'Un livre' : 'A book', text: fr ? `Qui a écrit « ${w.title} » (${w.year}) ?` : `Who wrote ${w.title} (${w.year})?`, options: opts.map((o: any) => o.name), answer: a.name, explain: `${w.title} (${w.year})${C}${a.name}, ${a.groupName}.`, learn: a.url, seen: [a.id] };
      },
      school() {
        const a = pick(D.authors.filter((x: any) => x.group !== 'root' && x.group !== 'trunk'));
        const wrong = shuffle(D.groups.filter((g: any) => g.id !== a.group && g.id !== 'root' && g.id !== 'trunk')).slice(0, 3);
        const opts = shuffle([groupName.get(a.group), ...wrong.map((g: any) => g.name)]);
        const seed = a.seeds[0];
        return { kind: fr ? 'Une école' : 'A school', text: fr ? `À quelle école appartient ${a.name} ?` : `Which school does ${a.name} belong to?`, options: opts, answer: a.groupName, explain: `${a.name}${C}${a.groupName}.${seed ? ` ${seed.name}${C}${seed.text}` : ''}`, learn: a.url, seen: [a.id] };
      },
      critique() {
        const k = pick(D.critiques);
        const critic: any = byId.get(k.critic);
        const target: any = byId.get(k.target);
        const others = shuffle(D.critiques.filter((x: any) => x.critic !== k.critic)).slice(0, 3);
        const options = shuffle([k, ...others].map((x: any) => mask(x.note, byId.get(x.critic))));
        const answer = mask(k.note, critic);
        return { kind: fr ? 'Une critique' : 'A critique', text: fr ? `Quelle critique doit-on à ${critic.name} ?` : `Which critique do we owe to ${critic.name}?`, options, answer, explain: `${critic.name} → ${target.name}${C}${k.note}`, learn: critic.url, seen: [critic.id, target.id] };
      },
    };
    const MODES: Record<string, string[]> = { all: ['idea', 'work', 'school', 'critique'] };

    let questions: Q[] = [];
    let i = 0;
    let score = 0;
    const met = new Set<string>();

    const build = (mode: string) => {
      const kinds = MODES[mode];
      const order = [...shuffle(kinds), ...shuffle(kinds)];
      const out: Q[] = [];
      const used = new Set<string>();
      let guard = 0;
      while (out.length < 10 && guard < 200) {
        guard += 1;
        const kind = out.length < 8 ? order[out.length] : pick(kinds);
        const q = makers[kind]();
        if (!q || used.has(q.text + q.answer)) continue;
        used.add(q.text + q.answer);
        out.push(q);
      }
      return out;
    };

    const render = () => {
      const q = questions[i];
      $('[data-bar]').style.width = `${(i / questions.length) * 100}%`;
      $('[data-step]').textContent = `${i + 1} / ${questions.length}`;
      $('[data-score]').textContent = `${fr ? 'Score' : 'Score'} ${score}`;
      $('[data-kind]').textContent = q.kind;
      $('[data-question]').textContent = q.text;
      const box = $('[data-options]');
      box.replaceChildren();
      for (const o of q.options) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'opt';
        b.textContent = o;
        b.addEventListener('click', () => answer(b, o));
        box.append(b);
      }
      $('[data-feedback]').hidden = true;
    };

    const answer = (btn: HTMLButtonElement, o: string) => {
      const q = questions[i];
      const ok = o === q.answer;
      if (ok) score += 1;
      q.seen.forEach((id) => met.add(id));
      for (const b of root.querySelectorAll<HTMLButtonElement>('.opt')) {
        b.disabled = true;
        if (b.textContent === q.answer) b.classList.add('right');
      }
      if (!ok) btn.classList.add('wrong');
      $('[data-verdict]').textContent = ok ? (fr ? 'Juste.' : 'Right.') : fr ? `Non\u00a0: ${q.answer}.` : `No: ${q.answer}.`;
      $('[data-verdict]').className = `verdict ${ok ? 'ok' : 'ko'}`;
      $('[data-explain]').textContent = q.explain;
      $<HTMLAnchorElement>('[data-learn]').href = q.learn;
      $('[data-score]').textContent = `Score ${score}`;
      $('[data-feedback]').hidden = false;
      $<HTMLButtonElement>('[data-next]').focus();
    };

    const finish = () => {
      $('[data-game]').hidden = true;
      $('[data-end]').hidden = false;
      $('[data-final]').textContent = `${score} / ${questions.length}`;
      $('[data-final-text]').textContent =
        score >= 8 ? (fr ? 'Vous connaissez bien la forêt.' : 'You know the forest well.') : score >= 5 ? (fr ? 'Une bonne promenade sous la canopée.' : 'A good walk under the canopy.') : fr ? 'Chaque feuille est une porte : en voici quelques-unes à ouvrir.' : 'Every leaf is a door: here are a few to open.';
      const ul = $('[data-met]');
      ul.replaceChildren();
      for (const id of [...met].slice(0, 12)) {
        const a: any = byId.get(id);
        const li = document.createElement('li');
        const link = document.createElement('a');
        link.href = a.url;
        link.className = 'met-card';
        const span = document.createElement('span');
        span.textContent = a.name;
        link.append(span);
        li.append(link);
        ul.append(li);
      }
    };

    const start = (mode: string) => {
      questions = build(mode);
      i = 0;
      score = 0;
      met.clear();
      $('[data-start]').hidden = true;
      $('[data-end]').hidden = true;
      $('[data-game]').hidden = false;
      render();
    };

    root.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) => b.addEventListener('click', () => start(b.dataset.mode!)));
    $('[data-next]').addEventListener('click', () => {
      i += 1;
      if (i >= questions.length) finish();
      else render();
    });
    $('[data-again]').addEventListener('click', () => {
      $('[data-end]').hidden = true;
      $('[data-start]').hidden = false;
    });
  }
</script>

<style>
  .start,
  .end {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    max-width: 760px;
  }
  .kinds {
    margin: 0;
    padding-left: 1.2em;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  [hidden] {
    display: none !important;
  }
  .game {
    max-width: 760px;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .progress {
    height: 6px;
    border-radius: var(--radius-pill);
    background: var(--line);
    overflow: hidden;
  }
  .progress span {
    display: block;
    height: 100%;
    background: var(--moss);
    transition: width 240ms ease-out;
  }
  .meta {
    display: flex;
    justify-content: space-between;
  }
  .q {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--line);
    border-radius: 0 24px 0 24px;
    background: var(--paper-raised);
  }
  .q-text {
    margin: 0;
  }
  .options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: var(--space-3);
    width: 100%;
  }
  .options :global(.opt) {
    min-height: 48px;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: var(--paper);
    color: var(--ink);
    font: 500 16px/22px var(--font-sans);
    text-align: left;
    cursor: pointer;
  }
  .options :global(.opt:hover:not(:disabled)) {
    border-color: var(--moss);
  }
  .options :global(.opt.right) {
    border-color: var(--moss);
    background: var(--moss-soft);
    font-weight: 600;
  }
  .options :global(.opt.wrong) {
    border-color: var(--branch-ecosocialism);
    text-decoration: line-through;
  }
  .feedback {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    width: 100%;
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
  }
  .verdict {
    margin: 0;
    font: 600 18px/24px var(--font-display);
  }
  .verdict.ok {
    color: var(--moss);
  }
  .row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
  }
  .met {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .met :global(.met-card) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3) var(--space-1) var(--space-1);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    color: var(--ink);
    text-decoration: none;
    font: 500 14px/1 var(--font-sans);
  }
  .met :global(.met-card img) {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 30%;
  }
</style>
