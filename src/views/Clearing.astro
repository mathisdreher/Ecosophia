---
// The Clearing: simulated debates between author-agents. Nothing here is ever
// set as a quotation. The page shows the latest published run; until there is
// one, it shows a hand-written specimen and says so.
import Base from '../layouts/Base.astro';
import RunBoard from '../components/RunBoard.astro';
import VoiceCard from '../components/VoiceCard.astro';
import ClaimSource from '../components/ClaimSource.astro';
import QuestionPositions from '../components/QuestionPositions.astro';
import { useUi } from '../i18n/ui.mjs';
import { href } from '../lib/site.mjs';
import { L } from '../lib/text.mjs';
import { loadClearing, loadQuestions, runMeasures } from '../lib/corpus.mjs';
import { spreadVoices, runDate } from '../lib/clearing.mjs';
import { SITE } from '../site.config.mjs';

const { lang } = Astro.props;
const { t } = useUi(lang);
const { specimen, published } = loadClearing();
const latest = published[0] ?? null;
const allQuestions = loadQuestions();
const questions = allQuestions.filter((q) => q.kind !== 'axiom');
const axioms = allQuestions.filter((q) => q.kind === 'axiom');
const runsOf = (id) => published.filter((r) => r.question?.id === id || r.claimSource?.id === id);
const asMeasures = (q) => q.measures.map((m) => ({ stance: m.stance, party: m.claim.party, programme: m.claim.programme, locator: m.claim.locator, quote: m.claim.quote }));
const run = latest ?? specimen;
const voices = latest ? spreadVoices(latest.voices, 6) : run.voices;
const metaOf = (r) => t('clearing.runMeta', { agents: r.settings.agents, rounds: r.settings.rounds, comments: r.counts.comments, date: runDate(r, lang) });
---

<Base lang={lang} view="clearing" title={t('clearing.title')} description={t('clearing.lede')}>
  <section class="intro">
    <div class="pitch">
      <span class="eco-mark simulated">{t('common.simulated')}</span>
      <h1 class="t-display">{t('clearing.title')}</h1>
      <p class="t-lede">{t('clearing.lede')}</p>
    </div>
    {
      SITE.repoPublic ? (
        <form class="claim" action={`${SITE.repoUrl}/issues/new`} method="get" target="_blank" rel="noopener">
          <label class="label" for="claim">{t('clearing.formLabel')}</label>
          <textarea id="claim" name="claim" rows="3">{L(run.claim, lang)}</textarea>
          <input type="hidden" name="template" value="clearing.yml" />
          <input type="hidden" name="title" value={lang === 'fr' ? 'Clairière : ' : 'Clearing: '} />
          <div class="row gap-4">
            <button class="eco-btn" type="submit">{t('clearing.propose')}</button>
            <span class="eco-meta">{t('clearing.proposeNote')}</span>
          </div>
        </form>
      ) : (
        <div class="claim">
          <span class="label">{t('clearing.formLabel')}</span>
          <p class="claim-text">{L(run.claim, lang)}</p>
          <span class="eco-meta">
            {t('clearing.proposeClosed')} {t('clearing.proposeNote')}
          </span>
        </div>
      )
    }
  </section>

  <section class="wrap">
    {
      latest ? (
        <div class="latest stack gap-2">
          <span class="label lichen-ink">
            {t('clearing.latest')} · {latest.runId}
          </span>
          <h2 class="t-title claim-line">{L(latest.claim, lang)}</h2>
          <p class="t-lede summary">{L(latest.summary, lang)}</p>
          <span class="eco-meta">{metaOf(latest)}</span>
          {latest.claimSource && <ClaimSource source={latest.claimSource} lang={lang} />}
          {latest.question && <QuestionPositions measures={runMeasures(latest, allQuestions)} lang={lang} />}
        </div>
      ) : (
        <div class="notice lichen">
          <b class="label">{t('clearing.specimenTitle')}</b>
          <p class="t-small">{t('clearing.specimen')}</p>
        </div>
      )
    }
  </section>

  <section class="wrap run-wrap">
    <RunBoard run={run} lang={lang} mark={latest ? 'simulated' : 'specimen'} />
  </section>

  <section class="voices wrap">
    <h2 class="t-heading">{t(latest ? 'clearing.voicesRun' : 'clearing.voicesTitle')}</h2>
    <div class="voice-grid">
      {voices.map((v) => <VoiceCard voice={v} run={run} lang={lang} />)}
    </div>
    {
      latest && (
        <a class="eco-btn read" href={href(lang, 'run', latest.id)}>
          {t('clearing.readRun')}
        </a>
      )
    }
  </section>

  {
    published.length > 1 && (
      <section class="wrap runs">
        <h2 class="t-heading">{t('clearing.allRuns')}</h2>
        <ul>
          {published.map((r) => (
            <li>
              <a class="strong-link" href={href(lang, 'run', r.id)}>{L(r.claim, lang)}</a>
              <span class="eco-meta">
                {r.runId} · {metaOf(r)}
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <div class="below-grid" slot="below">
    <div class="below-col">
      <div class="below-head">
        <span class="label humus">{t('clearing.corpusLabel')}</span>
        <h2 class="t-heading">{t('clearing.corpusTitle')}</h2>
      </div>
      <p class="text">{t('clearing.corpus')}</p>
    </div>
    <div class="below-col">
      <div class="below-head">
        <span class="label humus">{t('clearing.limitsLabel')}</span>
        <h2 class="t-heading">{t('clearing.limitsTitle')}</h2>
      </div>
      <p class="text">{t('clearing.limits')}</p>
      {
        SITE.repoPublic && (
          <a class="link t-small" href={`${SITE.repoUrl}/issues/new?template=correction.yml&title=${encodeURIComponent(lang === 'fr' ? 'Retrait d’un agent : ' : 'Withdraw an agent: ')}`} rel="noopener">
            {t('clearing.withdraw')}
          </a>
        )
      }
    </div>
    <div class="below-col">
      <div class="below-head">
        <span class="label humus">{t('clearing.reproduceLabel')}</span>
        <h2 class="t-heading">{t('clearing.reproduceTitle')}</h2>
      </div>
      <p class="text">{t('clearing.reproduce')}</p>
      <a class="link t-small" href={href(lang, 'method', undefined, 'simulated')}>{t('clearing.readMethod')}</a>
    </div>
    {
      questions.length > 0 && (
        <div class="below-col wide claims">
          <div class="below-head">
            <span class="label humus">{t('clearing.claimsLabel')}</span>
            <h2 class="t-heading">{t('clearing.questionsTitle')}</h2>
          </div>
          <p class="text">{t('clearing.questions')}</p>
          <ul>
            {questions.map((q) => (
              <li>
                <span class="text">
                  {L(q.claim, lang)} <code class="eco-meta">{q.id}</code>
                  {runsOf(q.id).length > 0 && (
                    <span class="eco-meta">
                      {' '}· {t('clearing.claimsRun')}{' '}
                      {runsOf(q.id).map((r) => (
                        <a href={href(lang, 'run', r.id)}>{r.runId}</a>
                      ))}
                    </span>
                  )}
                </span>
                <QuestionPositions measures={asMeasures(q)} lang={lang} />
              </li>
            ))}
          </ul>
        </div>
      )
    }
    {
      axioms.length > 0 && (
        <div class="below-col wide claims">
          <div class="below-head">
            <span class="label humus">{t('clearing.axiomsLabel')}</span>
            <h2 class="t-heading">{t('clearing.axiomsTitle')}</h2>
          </div>
          <p class="text">{t('clearing.axioms')}</p>
          <ul>
            {axioms.map((q) => (
              <li>
                <span class="text">
                  {L(q.claim, lang)} <code class="eco-meta">{q.id}</code>
                  {runsOf(q.id).length > 0 && (
                    <span class="eco-meta">
                      {' '}· {t('clearing.claimsRun')}{' '}
                      {runsOf(q.id).map((r) => (
                        <a href={href(lang, 'run', r.id)}>{r.runId}</a>
                      ))}
                    </span>
                  )}
                </span>
                {q.note && <span class="eco-meta">{L(q.note, lang)}</span>}
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</Base>

<style>
  .intro {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8) 80px;
    align-items: flex-start;
    padding: 72px var(--gutter) var(--space-8);
  }
  .pitch {
    flex: 1 1 440px;
    max-width: 600px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }
  .claim {
    flex: 1 1 480px;
    max-width: 640px;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }
  textarea,
  .claim-text {
    box-sizing: border-box;
    width: 100%;
    padding: var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--paper);
    color: var(--ink);
    font: 400 22px/30px var(--font-display);
    resize: vertical;
  }
  .latest {
    max-width: 860px;
    padding-top: var(--space-8);
  }
  .lichen-ink {
    color: var(--lichen-ink);
  }
  .claim-line {
    text-wrap: balance;
  }
  .summary {
    max-width: var(--measure);
  }
  .run-wrap {
    padding-block: var(--space-8) 56px;
  }
  .voices {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-bottom: 72px;
  }
  .voice-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
    gap: 20px;
  }
  .read {
    align-self: flex-start;
  }
  .runs {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-bottom: 72px;
  }
  .runs ul {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: var(--measure);
  }
  .runs li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-3) 0;
    border-top: 1px solid var(--line);
  }
  .claims {
    grid-column: 1 / -1;
    max-width: 900px;
  }
  .claims ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .claims li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-3) 0;
    border-top: 1px solid var(--line);
  }
  .claims code {
    font: inherit;
  }
  .below-col .text {
    font-size: 15px;
    line-height: 23px;
  }
  @media (max-width: 720px) {
    .intro {
      padding-top: var(--space-12);
    }
  }
</style>
