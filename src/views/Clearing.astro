---
// The Clearing: simulated debates between author-agents. Nothing here is ever
// set as a quotation. Until a first run is published, the page shows a
// hand-written specimen and says so.
import Base from '../layouts/Base.astro';
import BranchChip from '../components/BranchChip.astro';
import { useUi } from '../i18n/ui.mjs';
import { href } from '../lib/site.mjs';
import { L, titleHtml, yearLabel } from '../lib/text.mjs';
import { loadCorpus, loadClearing } from '../lib/corpus.mjs';
import { SITE } from '../site.config.mjs';

const { lang } = Astro.props;
const { t } = useUi(lang);
const c = loadCorpus();
const { specimen: run } = loadClearing();
const positions = [...run.positions].sort((a, b) => a.score - b.score);
const names = (al) =>
  al.branches
    .map((b) => {
      const name = L(c.branchById[b].name, lang);
      return al.partial?.includes(b) ? (lang === 'fr' ? `une partie de ${name}` : `part of ${name}`) : name;
    })
    .join(' · ');
---

<Base lang={lang} view="clearing" title={t('clearing.title')} description={t('clearing.lede')}>
  <section class="intro">
    <div class="pitch">
      <span class="eco-mark simulated">{t('common.simulated')}</span>
      <h1 class="t-display">{t('clearing.title')}</h1>
      <p class="t-lede">{t('clearing.lede')}</p>
    </div>
    {
      SITE.repoPublic ? (
        <form class="claim" action={`${SITE.repoUrl}/issues/new`} method="get" target="_blank" rel="noopener">
          <label class="label" for="claim">{t('clearing.formLabel')}</label>
          <textarea id="claim" name="claim" rows="3">{L(run.claim, lang)}</textarea>
          <input type="hidden" name="template" value="clearing.yml" />
          <input type="hidden" name="title" value={lang === 'fr' ? 'Clairière : ' : 'Clearing: '} />
          <div class="row gap-4">
            <button class="eco-btn" type="submit">{t('clearing.propose')}</button>
            <span class="eco-meta">{t('clearing.proposeNote')}</span>
          </div>
        </form>
      ) : (
        <div class="claim">
          <span class="label">{t('clearing.formLabel')}</span>
          <p class="claim-text">{L(run.claim, lang)}</p>
          <span class="eco-meta">
            {t('clearing.proposeClosed')} {t('clearing.proposeNote')}
          </span>
        </div>
      )
    }
  </section>

  <section class="wrap">
    <div class="notice lichen">
      <b class="label">{t('clearing.specimenTitle')}</b>
      <p class="t-small">{t('clearing.specimen')}</p>
    </div>
  </section>

  <section class="wrap run-wrap">
    <div class="run">
      <div class="stand">
        <div class="stack gap-1">
          <span class="eco-mark simulated-ink">{t('common.specimen')}</span>
          <h2 class="t-heading">{t('clearing.standTitle')}</h2>
          <p class="t-small t-muted">{t('clearing.stand')}</p>
        </div>
        <div class="eco-stance" role="list">
          {
            positions.map((p) => {
              const b = c.branchById[p.branch];
              const left = Math.min(p.score, 50);
              const width = Math.abs(p.score - 50);
              return (
                <>
                  <BranchChip branch={b} lang={lang} />
                  <div class="scale" style={`--chip: var(--${b.token})`} aria-hidden="true">
                    <div class="bar" style={`left: ${left}%; width: ${width}%`} />
                    <div class="dot" style={`left: ${p.score}%`} />
                  </div>
                  <span class="eco-meta value">{p.score}</span>
                </>
              );
            })
          }
          <span class="axis-pad"></span>
          <div class="axis eco-meta" aria-hidden="true">
            <span>{t('clearing.oppose')}</span>
            <span>{t('clearing.neutral')}</span>
            <span>{t('clearing.endorse')}</span>
          </div>
          <span></span>
        </div>
      </div>

      <div class="allies">
        <div class="stack gap-1">
          <span class="eco-mark simulated-ink">{t('common.specimen')}</span>
          <h2 class="t-heading">{t('clearing.alliesTitle')}</h2>
        </div>
        {
          run.alliances.map((al) => (
            <div class="ally">
              <b>{L(al.title, lang)}</b>
              <span class="t-small t-muted">{names(al)}</span>
              <span class="text">{L(al.text, lang)}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="voices wrap">
    <h2 class="t-heading">{t('clearing.voicesTitle')}</h2>
    <div class="voice-grid">
      {
        run.voices.map((v) => {
          const a = c.authorById[v.author];
          const w = c.sources.get(v.work);
          return (
            <div class="eco-sim">
              <span class="eco-mark simulated">{t('common.specimen')}</span>
              <b class="who">{t('clearing.specimenReaction', { name: a.name })}</b>
              <p>{L(v.text, lang)}</p>
              <span class="eco-meta">
                {t('clearing.writtenAfter')} <Fragment set:html={titleHtml(w, lang)} /> ({yearLabel(w)}) · {t('clearing.position')} {v.position} · {t('clearing.notStatement')}
              </span>
            </div>
          );
        })
      }
    </div>
  </section>

  <div class="below-grid" slot="below">
    <div class="below-col">
      <div class="below-head">
        <span class="label humus">{t('clearing.corpusLabel')}</span>
        <h2 class="t-heading">{t('clearing.corpusTitle')}</h2>
      </div>
      <p class="text">{t('clearing.corpus')}</p>
    </div>
    <div class="below-col">
      <div class="below-head">
        <span class="label humus">{t('clearing.limitsLabel')}</span>
        <h2 class="t-heading">{t('clearing.limitsTitle')}</h2>
      </div>
      <p class="text">{t('clearing.limits')}</p>
    </div>
    <div class="below-col">
      <div class="below-head">
        <span class="label humus">{t('clearing.reproduceLabel')}</span>
        <h2 class="t-heading">{t('clearing.reproduceTitle')}</h2>
      </div>
      <p class="text">{t('clearing.reproduce')}</p>
      <a class="link t-small" href={href(lang, 'method', undefined, 'simulated')}>{t('clearing.readMethod')}</a>
    </div>
  </div>
</Base>

<style>
  .intro {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8) 80px;
    align-items: flex-start;
    padding: 72px var(--gutter) var(--space-8);
  }
  .pitch {
    flex: 1 1 440px;
    max-width: 600px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }
  .claim {
    flex: 1 1 480px;
    max-width: 640px;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
  }
  textarea,
  .claim-text {
    box-sizing: border-box;
    width: 100%;
    padding: var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--paper);
    color: var(--ink);
    font: 400 22px/30px var(--font-display);
    resize: vertical;
  }
  .run-wrap {
    padding-block: var(--space-8) 56px;
  }
  .run {
    display: flex;
    flex-wrap: wrap;
    gap: 40px var(--space-16);
    padding: var(--space-8);
    border: var(--stroke-thread) dashed var(--lichen-ink);
    border-radius: var(--radius-md);
    background: var(--paper-raised);
  }
  .stand {
    flex: 999 1 560px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .stand :global(.eco-chip) {
    justify-self: start;
  }
  .allies {
    flex: 1 1 360px;
    max-width: 460px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .ally {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .ally b {
    font-size: 16px;
    line-height: 22px;
  }
  .ally .text,
  .below-col .text {
    font-size: 15px;
    line-height: 23px;
  }
  .voices {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-bottom: 72px;
  }
  .voice-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
    gap: 20px;
  }
  @media (max-width: 720px) {
    .run {
      padding: var(--space-4);
    }
    .intro {
      padding-top: var(--space-12);
    }
  }
  @media (max-width: 560px) {
    .axis-pad {
      display: none;
    }
  }
</style>
