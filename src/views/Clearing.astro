---
// The Clearing, light: what it is, one card per published debate with where
// the schools stood at a glance, and the questions still on the table. Each
// debate in full (positions, alliances, voices, transcript) lives on its own
// page. Nothing here is ever set as a quotation.
import Base from '../layouts/Base.astro';
import QuestionPositions from '../components/QuestionPositions.astro';
import { useUi } from '../i18n/ui.mjs';
import { href } from '../lib/site.mjs';
import { L, typo } from '../lib/text.mjs';
import { loadClearing, loadQuestions, loadCorpus } from '../lib/corpus.mjs';
import { runDate } from '../lib/clearing.mjs';
import { SITE } from '../site.config.mjs';

const { lang } = Astro.props;
const { t } = useUi(lang);
const T = (en, fr) => typo(lang === 'fr' ? fr : en, lang);
const c = loadCorpus();
const { published } = loadClearing();
const allQuestions = loadQuestions();
const runsOf = (id) => published.filter((r) => r.question?.id === id || r.claimSource?.id === id);
const asMeasures = (q) => q.measures.filter((m) => m.claim).map((m) => ({ stance: m.stance, party: m.claim.party, programme: m.claim.programme, locator: m.claim.locator, quote: m.claim.quote }));
const questions = allQuestions.filter((q) => q.kind !== 'axiom');
const axioms = allQuestions.filter((q) => q.kind === 'axiom');
const metaOf = (r) => t('clearing.runMeta', { agents: r.settings.agents, rounds: r.settings.rounds, comments: r.counts.comments, date: runDate(r, lang) });
const strip = (r) =>
  [...r.positions]
    .sort((a, b) => a.score - b.score)
    .map((p) => ({ ...p, b: c.branchById[p.branch] }))
    .filter((p) => p.b);
const proposeUrl = `${SITE.repoUrl}/issues/new?template=clearing.yml&title=${encodeURIComponent(lang === 'fr' ? 'Clairière : ' : 'Clearing: ')}`;
---

<Base lang={lang} view="clearing" title={t('clearing.title')} description={t('clearing.lede')}>
  <section class="intro wrap">
    <span class="eco-mark simulated">{t('common.simulated')}</span>
    <h1 class="t-display">{t('clearing.title')}</h1>
    <p class="t-lede">{T('Agents built from each author’s record debate a claim. The schools take positions, unexpected alliances appear. A simulation, never a statement by a real author.', 'Des agents construits à partir de la fiche de chaque auteur débattent d’une affirmation. Les écoles prennent position, des alliances inattendues apparaissent. Une simulation, jamais la parole d’un auteur réel.')}</p>
    {SITE.repoPublic && <a class="link t-small" href={proposeUrl} rel="noopener">{T('Propose a claim', 'Proposer une affirmation')}</a>}
  </section>

  <section class="wrap debates">
    <h2 class="t-heading">{T('Published debates', 'Débats publiés')}</h2>
    {
      published.length === 0 ? (
        <p class="t-small t-muted">{t('clearing.specimenTitle')}</p>
      ) : (
        <ul class="cards">
          {published.map((r) => (
            <li class="card">
              <a class="card-link" href={href(lang, 'run', r.id)}>
                <span class="eco-meta">
                  {r.runId} · {r.question?.kind === 'axiom' ? T('Axiom', 'Axiome') : r.question ? T('Programme question', 'Question de programme') : T('Claim', 'Affirmation')}
                </span>
                <h3 class="t-heading claim">{L(r.claim, lang)}</h3>
              </a>
              <div class="strip" role="img" aria-label={T('Where the schools stood, from against (left) to for (right)', 'Où se sont placées les écoles, de contre (à gauche) à pour (à droite)')}>
                <span class="axis" aria-hidden="true"></span>
                {strip(r).map((p) => (
                  <span class="dot" style={`left: ${p.score}%; --chip: var(--${p.b.token})`} title={`${L(p.b.name, lang)} · ${p.score}`}></span>
                ))}
                <span class="end left eco-meta">{t('clearing.oppose')}</span>
                <span class="end right eco-meta">{t('clearing.endorse')}</span>
              </div>
              <p class="t-small summary">{L(r.summary, lang)}</p>
              <div class="foot">
                <span class="eco-meta">{metaOf(r)}</span>
                <a class="eco-btn" href={href(lang, 'run', r.id)}>{T('Read the debate', 'Lire le débat')}</a>
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section class="wrap table">
    <h2 class="t-heading">{T('On the table', 'Sur la table')}</h2>
    <p class="t-small t-muted note">{T('Programme questions gather the measures of the French parties; the agents never see a party name. Axioms are claims that split the schools among themselves.', 'Les questions de programme rassemblent les mesures des partis français ; les agents ne voient jamais le nom d’un parti. Les axiomes sont des affirmations qui divisent les écoles entre elles.')}</p>
    <div class="cols">
      {[
        [T('Programme questions', 'Questions de programme'), questions],
        [T('Axioms', 'Axiomes'), axioms],
      ].map(([title, list]) => (
        <div>
          <h3 class="label">{title}</h3>
          <ul class="qs">
            {list.map((q) => (
              <li>
                <span class="q">{L(q.claim, lang)}</span>
                <span class="eco-meta">
                  {runsOf(q.id).length > 0
                    ? runsOf(q.id).map((r) => <a href={href(lang, 'run', r.id)}>{T('debated', 'débattu')} · {r.runId}</a>)
                    : T('not debated yet', 'pas encore débattu')}
                  {' · '}<code>{q.id}</code>
                </span>
                {q.measures?.length > 0 && (
                  <details>
                    <summary class="t-small">{T(`What the parties say (${q.measures.length})`, `Ce que disent les partis (${q.measures.length})`)}</summary>
                    <QuestionPositions measures={asMeasures(q)} lang={lang} />
                  </details>
                )}
                {q.note && <span class="t-small t-muted">{L(q.note, lang)}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <div class="below-grid" slot="below">
    <div class="below-col">
      <div class="below-head">
        <span class="label humus">{t('clearing.corpusLabel')}</span>
        <h2 class="t-heading">{t('clearing.corpusTitle')}</h2>
      </div>
      <p class="text">{t('clearing.corpus')}</p>
    </div>
    <div class="below-col">
      <div class="below-head">
        <span class="label humus">{t('clearing.limitsLabel')}</span>
        <h2 class="t-heading">{t('clearing.limitsTitle')}</h2>
      </div>
      <p class="text">{t('clearing.limits')}</p>
      {
        SITE.repoPublic && (
          <a class="link t-small" href={`${SITE.repoUrl}/issues/new?template=correction.yml&title=${encodeURIComponent(lang === 'fr' ? 'Retrait d’un agent : ' : 'Withdraw an agent: ')}`} rel="noopener">
            {t('clearing.withdraw')}
          </a>
        )
      }
    </div>
    <div class="below-col">
      <div class="below-head">
        <span class="label humus">{t('clearing.reproduceLabel')}</span>
        <h2 class="t-heading">{t('clearing.reproduceTitle')}</h2>
      </div>
      <p class="text">{t('clearing.reproduce')}</p>
      <a class="link t-small" href={href(lang, 'method', undefined, 'simulated')}>{t('clearing.readMethod')}</a>
    </div>
  </div>
</Base>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    padding-top: 56px;
    padding-bottom: var(--space-8);
    max-width: 760px;
  }
  .debates,
  .table {
    padding-bottom: 56px;
  }
  .cards {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(420px, 100%), 1fr));
    gap: var(--space-6);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    border: var(--stroke-thread) dashed var(--lichen-ink);
    border-radius: var(--radius-md);
    background: var(--paper-raised);
  }
  .card-link {
    color: inherit;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .card-link:hover .claim {
    text-decoration: underline;
  }
  .claim {
    margin: 0;
    text-wrap: balance;
  }
  .strip {
    position: relative;
    height: 44px;
    margin: var(--space-2) 6px 0;
  }
  .axis {
    position: absolute;
    left: 0;
    right: 0;
    top: 12px;
    border-top: 1px solid var(--line);
  }
  .axis::after {
    content: "";
    position: absolute;
    left: 50%;
    top: -6px;
    height: 12px;
    border-left: 1px dashed var(--line);
  }
  .dot {
    position: absolute;
    top: 6px;
    width: 12px;
    height: 12px;
    margin-left: -6px;
    border-radius: 50%;
    background: var(--chip);
    border: 2px solid var(--paper-raised);
  }
  .end {
    position: absolute;
    top: 24px;
  }
  .end.left {
    left: 0;
  }
  .end.right {
    right: 0;
  }
  .summary {
    margin: 0;
    color: var(--ink-muted);
  }
  .foot {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .note {
    max-width: 70ch;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr));
    gap: var(--space-8);
    margin-top: var(--space-4);
  }
  .qs {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
  }
  .qs li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--line);
  }
  .q {
    font: 500 17px/24px var(--font-sans);
  }
  details summary {
    cursor: pointer;
    color: var(--moss);
  }
  details[open] summary {
    margin-bottom: var(--space-2);
  }
</style>
