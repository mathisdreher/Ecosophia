---
// Canopy: authors placed on three axes, two plotted at a time, the third as a
// filter. Every filled marker is a reading of one work, listed with its reason
// below the ground line. An author with no reading on an axis is drawn hollow
// at the median of the branch, never filled.
import Base from '../layouts/Base.astro';
import BranchChip from '../components/BranchChip.astro';
import { useUi } from '../i18n/ui.mjs';
import { href } from '../lib/site.mjs';
import { L, citeHtml } from '../lib/text.mjs';
import { loadCorpus, loadCanopy, CANOPY_AXES } from '../lib/corpus.mjs';

const { lang } = Astro.props;
const { t, dict } = useUi(lang);
const c = loadCorpus();
const placements = loadCanopy();
const axes = Object.fromEntries(CANOPY_AXES.map((id, i) => [id, dict.canopy.axes[i]]));

const byAuthor = new Map();
for (const p of placements) {
  if (!byAuthor.has(p.author)) byAuthor.set(p.author, {});
  byAuthor.get(p.author)[p.axis] = p;
}
const median = (xs) => {
  const s = [...xs].sort((a, b) => a - b);
  const m = Math.floor(s.length / 2);
  return s.length ? (s.length % 2 ? s[m] : (s[m - 1] + s[m]) / 2) : null;
};
const branchMedian = {};
for (const b of c.branches) {
  branchMedian[b.id] = {};
  for (const axis of CANOPY_AXES) {
    branchMedian[b.id][axis] = median(placements.filter((p) => p.axis === axis && c.authorById[p.author].branch === b.id).map((p) => p.score));
  }
}
const points = [...byAuthor.entries()].map(([id, scores]) => {
  const a = c.authorById[id];
  const b = c.branchById[a.branch];
  return {
    id,
    name: a.name,
    short: a.short,
    branch: b.id,
    branchName: L(b.name, lang),
    token: b.token,
    url: href(lang, 'author', id),
    scores: Object.fromEntries(CANOPY_AXES.map((axis) => [axis, scores[axis]?.score ?? null])),
    medians: branchMedian[b.id],
  };
});
const branchesShown = c.branches.filter((b) => points.some((p) => p.branch === b.id));
const leaves = c.authors.filter((a) => a.layer === 'leaf').length;
const rows = [...placements].sort(
  (x, y) => c.authorById[x.author].sort.localeCompare(c.authorById[y.author].sort) || CANOPY_AXES.indexOf(x.axis) - CANOPY_AXES.indexOf(y.axis),
);
const data = { points, axes: Object.fromEntries(CANOPY_AXES.map((id) => [id, { name: axes[id].name, low: axes[id].low, high: axes[id].high }])) };
---

<Base lang={lang} view="canopy" title={t('canopy.title')} description={t('canopy.lede')}>
  <section class="page-head">
    <span class="label t-muted">{t('canopy.firstReadings')}</span>
    <h1 class="t-title">{t('canopy.title')}</h1>
    <p class="t-lede">{t('canopy.lede')}</p>
    <p class="t-small t-muted">{t('canopy.statusNow', { n: points.length, m: leaves, k: placements.length })}</p>
  </section>

  <section class="page-body stack gap-6" data-canopy>
    <script type="application/json" data-canopy-data set:html={JSON.stringify(data)} />
    <div class="controls">
      <label>
        <span class="label t-muted">{t('canopy.xAxis')}</span>
        <select data-axis="x">
          {CANOPY_AXES.map((id) => <option value={id} selected={id === 'power'}>{axes[id].name}</option>)}
        </select>
      </label>
      <label>
        <span class="label t-muted">{t('canopy.yAxis')}</span>
        <select data-axis="y">
          {CANOPY_AXES.map((id) => <option value={id} selected={id === 'nature'}>{axes[id].name}</option>)}
        </select>
      </label>
      <label>
        <span class="label t-muted" data-third-label>{t('canopy.filter')}</span>
        <select data-filter>
          <option value="all">{t('canopy.filterAll')}</option>
          <option value="low">{t('canopy.filterLow')}</option>
          <option value="high">{t('canopy.filterHigh')}</option>
        </select>
      </label>
    </div>

    <div class="plot-wrap">
      <svg class="plot" viewBox="0 0 680 560" role="img" aria-label={t('canopy.plotLabel')} data-plot>
        <rect class="frame" x="70" y="20" width="580" height="460" />
        <line class="mid" x1="360" y1="20" x2="360" y2="480" />
        <line class="mid" x1="70" y1="250" x2="650" y2="250" />
        <text class="end" x="70" y="504" text-anchor="start" data-x-low></text>
        <text class="end" x="650" y="504" text-anchor="end" data-x-high></text>
        <text class="axis-name" x="360" y="534" text-anchor="middle" data-x-name></text>
        <text class="end" x="58" y="480" text-anchor="start" transform="rotate(-90 58 480)" data-y-low></text>
        <text class="end" x="58" y="20" text-anchor="end" transform="rotate(-90 58 20)" data-y-high></text>
        <text class="axis-name" x="28" y="250" text-anchor="middle" transform="rotate(-90 28 250)" data-y-name></text>
        <g data-points></g>
      </svg>
      <aside class="side">
        <div class="legend">
          {branchesShown.map((b) => <BranchChip branch={b} lang={lang} />)}
        </div>
        <ul class="t-small t-muted keys">
          <li><span class="k filled" aria-hidden="true"></span>{t('canopy.keyFilled')}</li>
          <li><span class="k hollow" aria-hidden="true"></span>{t('canopy.keyHollow')}</li>
        </ul>
        <p class="t-small" data-hover>{t('canopy.hoverHint')}</p>
      </aside>
    </div>

    <div class="prose">
      <h2>{t('canopy.rulesTitle')}</h2>
      <ul>
        {dict.canopy.rules.map((r) => <li>{r}</li>)}
      </ul>
    </div>
  </section>

  <div slot="below" class="below-grid">
    <div class="below-col wide">
      <div class="below-head">
        <span class="label humus">{t('canopy.readingsLabel')}</span>
        <h2 class="t-heading">{t('canopy.readingsTitle')}</h2>
      </div>
      <p class="text">{t('canopy.readings')}</p>
      <div class="table-wrap">
        <table class="eco-table readings">
          <thead>
            <tr>
              <th scope="col">{t('canopy.author')}</th>
              <th scope="col">{t('canopy.axis')}</th>
              <th scope="col">{t('canopy.score')}</th>
              <th scope="col">{t('canopy.reading')}</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((p) => (
              <tr id={`reading-${p.author}-${p.axis}`}>
                <th scope="row">
                  <a class="strong-link" href={href(lang, 'author', p.author)}>{c.authorById[p.author].name}</a>
                </th>
                <td>{axes[p.axis].name}</td>
                <td class="num">{p.score}</td>
                <td>
                  {L(p.note, lang)}{' '}
                  <span class="eco-meta">
                    <Fragment set:html={citeHtml(c.sources.get(p.source), lang)} />
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('[data-canopy]');
  if (root) {
    const data = JSON.parse(root.querySelector('[data-canopy-data]')!.textContent!);
    const svg = root.querySelector<SVGSVGElement>('[data-plot]')!;
    const g = svg.querySelector<SVGGElement>('[data-points]')!;
    const xSel = root.querySelector<HTMLSelectElement>('[data-axis="x"]')!;
    const ySel = root.querySelector<HTMLSelectElement>('[data-axis="y"]')!;
    const fSel = root.querySelector<HTMLSelectElement>('[data-filter]')!;
    const thirdLabel = root.querySelector<HTMLElement>('[data-third-label]')!;
    const hover = root.querySelector<HTMLElement>('[data-hover]')!;
    const hint = hover.textContent;
    const filterWord = thirdLabel.textContent;
    const NS = 'http://www.w3.org/2000/svg';
    const X = (v: number) => 70 + (v / 100) * 580;
    const Y = (v: number) => 480 - (v / 100) * 460;
    const set = (sel: string, text: string) => (svg.querySelector(sel)!.textContent = text);

    const draw = () => {
      if (xSel.value === ySel.value) {
        const other = ['nature', 'change', 'power'].find((a) => a !== xSel.value)!;
        ySel.value = other;
      }
      const xa = xSel.value;
      const ya = ySel.value;
      const third = ['nature', 'change', 'power'].find((a) => a !== xa && a !== ya)!;
      thirdLabel.textContent = `${filterWord} · ${data.axes[third].name}`;
      set('[data-x-low]', data.axes[xa].low);
      set('[data-x-high]', data.axes[xa].high);
      set('[data-x-name]', data.axes[xa].name);
      set('[data-y-low]', data.axes[ya].low);
      set('[data-y-high]', data.axes[ya].high);
      set('[data-y-name]', data.axes[ya].name);
      g.replaceChildren();
      // Every marker is placed first; labels then go where they hide neither a
      // marker nor another label, filled markers choosing first.
      const shown = [];
      for (const p of data.points) {
        const tv = p.scores[third] ?? p.medians[third];
        if (fSel.value === 'low' && !(tv != null && tv < 50)) continue;
        if (fSel.value === 'high' && !(tv != null && tv >= 50)) continue;
        const xv = p.scores[xa] ?? p.medians[xa];
        const yv = p.scores[ya] ?? p.medians[ya];
        if (xv == null || yv == null) continue;
        shown.push({ p, cx: X(xv), cy: Y(yv), filled: p.scores[xa] != null && p.scores[ya] != null });
      }
      shown.sort((a, b) => Number(b.filled) - Number(a.filled));
      const boxes: number[][] = shown.map(({ cx, cy }) => [cx - 8, cy - 8, cx + 8, cy + 8]);
      const free = (bx: number[]) => bx[0] >= 72 && bx[2] <= 648 && bx[1] >= 22 && bx[3] <= 478 && !boxes.some((o) => bx[0] < o[2] && bx[2] > o[0] && bx[1] < o[3] && bx[3] > o[1]);
      const nodes = shown.map(({ p, cx, cy, filled }) => {
        const a = document.createElementNS(NS, 'a');
        a.setAttribute('href', p.url);
        a.setAttribute('class', `pt${filled ? '' : ' hollow'}`);
        a.style.setProperty('--chip', `var(--${p.token})`);
        const title = document.createElementNS(NS, 'title');
        title.textContent = `${p.name} · ${p.branchName} · ${data.axes[xa].name} ${p.scores[xa] ?? '–'} · ${data.axes[ya].name} ${p.scores[ya] ?? '–'}`;
        const circle = document.createElementNS(NS, 'circle');
        circle.setAttribute('cx', String(cx));
        circle.setAttribute('cy', String(cy));
        circle.setAttribute('r', '7');
        a.append(title, circle);
        const w = p.short.length * 6.4;
        const spots: [number, number, string][] = [
          [cx + 10, cy + 4, 'start'],
          [cx - 10, cy + 4, 'end'],
          [cx, cy - 12, 'middle'],
          [cx, cy + 20, 'middle'],
        ];
        for (const [tx, ty, anchor] of spots) {
          const x0 = anchor === 'start' ? tx : anchor === 'end' ? tx - w : tx - w / 2;
          const bx = [x0, ty - 10, x0 + w, ty + 3];
          if (!free(bx)) continue;
          const label = document.createElementNS(NS, 'text');
          label.setAttribute('x', String(tx));
          label.setAttribute('y', String(ty));
          label.setAttribute('text-anchor', anchor);
          label.textContent = p.short;
          a.append(label);
          boxes.push(bx);
          break;
        }
        a.addEventListener('mouseenter', () => (hover.textContent = title.textContent));
        a.addEventListener('focus', () => (hover.textContent = title.textContent));
        a.addEventListener('mouseleave', () => (hover.textContent = hint));
        return a;
      });
      // Hollow markers underneath, filled ones on top.
      g.append(...nodes.reverse());
    };
    [xSel, ySel, fSel].forEach((s) => s.addEventListener('change', draw));
    draw();
  }
</script>

<style>
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-8);
  }
  .controls label {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  select {
    min-height: 36px;
    padding: 0 var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--paper-raised);
    color: var(--ink);
    font: 400 15px/1 var(--font-sans);
  }
  .plot-wrap {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(220px, 1fr);
    gap: var(--space-8);
    align-items: start;
  }
  .plot {
    width: 100%;
    height: auto;
    display: block;
  }
  .frame {
    fill: var(--paper-raised);
    stroke: var(--line);
  }
  .mid {
    stroke: var(--line);
    stroke-dasharray: 4 4;
  }
  .end {
    font: 400 12px/1 var(--font-sans);
    fill: var(--ink-muted);
  }
  .axis-name {
    font: 600 13px/1 var(--font-sans);
    fill: var(--ink);
  }
  .plot :global(.pt circle) {
    fill: var(--chip);
    stroke: var(--paper-raised);
    stroke-width: 2;
  }
  .plot :global(.pt.hollow circle) {
    fill: var(--paper-raised);
    stroke: var(--chip);
    stroke-width: 2;
    stroke-dasharray: 3 2;
  }
  .plot :global(.pt text) {
    font: 500 11px/1 var(--font-sans);
    fill: var(--ink);
    paint-order: stroke;
    stroke: var(--paper-raised);
    stroke-width: 3px;
  }
  .plot :global(.pt.hollow text) {
    fill: var(--ink-muted);
  }
  .plot :global(.pt:hover circle),
  .plot :global(.pt:focus-visible circle) {
    stroke: var(--ink);
  }
  .side {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .keys {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .keys li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .k {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    flex: none;
  }
  .k.filled {
    background: var(--ink);
  }
  .k.hollow {
    border: 2px dashed var(--ink);
  }
  .below-col.wide {
    grid-column: 1 / -1;
  }
  .readings td,
  .readings th {
    vertical-align: top;
    font-size: 14px;
    line-height: 20px;
  }
  .readings .num {
    text-align: right;
    font-family: var(--font-mono);
  }
  @media (max-width: 900px) {
    .plot-wrap {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
