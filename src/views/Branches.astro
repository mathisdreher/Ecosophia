---
// All branches, in the order they stand on the tree.
import Emblem from '../components/Emblem.astro';
import Base from '../layouts/Base.astro';
import BranchChip from '../components/BranchChip.astro';
import { useUi } from '../i18n/ui.mjs';
import { href } from '../lib/site.mjs';
import { L } from '../lib/text.mjs';
import { loadCorpus } from '../lib/corpus.mjs';

const { lang } = Astro.props;
const { t } = useUi(lang);
const c = loadCorpus();
const title = t('branch.all');
---

<Base lang={lang} view="branches" title={title}>
  <section class="page-head">
    <nav class="crumbs" aria-label={lang === 'fr' ? 'Fil d’Ariane' : 'Breadcrumb'}>
      <a href={href(lang, 'home')}>{t('tabs.tree')}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{title}</span>
    </nav>
    <h1 class="t-title">{title}</h1>
    <p class="t-lede">{t('home.p2')}</p>
  </section>
  <section class="page-body">
    <ul class="branches">
      {
        c.branches.map((b) => (
          <li style={`--chip: var(--${b.token})`} class:list={{ graft: b.graft }}>
            <div class="row gap-3">
              <BranchChip branch={b} lang={lang} />
              <span class="eco-meta">
                {b.authors.length} {t('common.leaves')}
                {b.graft && ` · ${t('common.graft')}`}
              </span>
            </div>
            <h2 class="t-heading with-emblem"><Emblem branch={b.id} size={28} /><a href={href(lang, 'branch', b.id)}>{L(b.full, lang)}</a></h2>
            <p>{L(b.summary, lang)}</p>
            <p class="t-small">
              {b.authors.map((a, i) => (
                <>
                  {i > 0 && <span aria-hidden="true"> · </span>}
                  <a class="link" href={href(lang, 'author', a.id)}>{a.name}</a>
                </>
              ))}
            </p>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .branches {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(420px, 100%), 1fr));
    gap: var(--space-8) var(--space-12);
  }
  li {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: var(--stroke-branch) solid var(--chip);
  }
  li.graft {
    border-top: var(--stroke-thread) dashed var(--chip);
  }
  h2 a:hover {
    color: var(--chip);
  }
  .with-emblem {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
</style>
